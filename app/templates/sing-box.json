{
  "log": {
    "level": "error"
  },
  "dns": {
    "servers": [
      {
        "type": "udp",
        "tag": "dns-remote",
        "server": "1.1.1.1",
        "server_port": 53,
        "detour": "proxy"
      },
      {
        "type": "udp",
        "tag": "dns-backup",
        "server": "8.8.8.8",
        "server_port": 53,
        "detour": "proxy"
      }
    ],
    "final": "dns-remote",
    "strategy": "ipv4_only"
  },
  "inbounds": [
    {
      "type": "tun",
      "tag": "tun-in",
      "interface_name": "throne-tun",
      "address": [
        "172.19.0.1/30",
        "fdfe:dcba:9876::1/126"
      ],
      "auto_route": true,
      "strict_route": true
    }
  ],
  "outbounds": [
    {
      "type": "selector",
      "tag": "proxy",
      "default": "vless-vision",
      "outbounds": [
        "vless-vision"
      ],
      "interrupt_exist_connections": true
    }
  ],
  "route": {
    "rules": [
      {
        "action": "sniff"
      },
      {
        "protocol": "dns",
        "action": "hijack-dns"
      },
      {
        "protocol": [
          "quic",
          "stun",
          "bittorrent"
        ],
        "action": "reject"
      },
      {
        "network": "udp",
        "port": [
          443,
          3478,
          19302
        ],
        "action": "reject"
      },
      {
        "domain": [
          "location.googleapis.com",
          "connectivitycheck.android.com",
          "connectivitycheck.gstatic.com"
        ],
        "domain_suffix": [
          "app-measurement.com",
          "firebase-settings.crashlytics.com"
        ],
        "action": "reject"
      },
      {
        "ip_is_private": true,
        "action": "reject"
      },
      {
        "ip_cidr": [
          "::/0"
        ],
        "action": "reject"
      }
    ],
    "final": "proxy",
    "auto_detect_interface": true
  },
  "experimental": {
    "cache_file": {
      "enabled": true
    }
  }
}
