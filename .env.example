# Marzneshin Single-Server VLESS Self-Reality Appliance Environment

APPLIANCE_MODE="true"
APPLIANCE_DOMAIN=""
SECRET_PANEL_PATH=""
SETUP_TOKEN=""

## Backend API (bound strictly to loopback behind Nginx)
UVICORN_HOST="127.0.0.1"
UVICORN_PORT=8000

## Database
SQLALCHEMY_DATABASE_URL="sqlite:////var/lib/marzneshin/db.sqlite3"

## Local Xray Engine
XRAY_API_ADDRESS="127.0.0.1:10085"
XRAY_LISTEN_PORT=443
XRAY_XHTTP_PORT=10086
XRAY_CONFIG_PATH="/var/lib/marzneshin/xray/config.json"
XRAY_BINARY_PATH="/usr/local/bin/xray"

## Nginx Self-Steal Gateway
NGINX_RUNTIME_DIR="/var/lib/marzneshin/nginx-runtime"
NGINX_HTTPS_FALLBACK_PORT=8443
NGINX_ACME_CERT_PATH="/var/lib/marzneshin/certs/fullchain.pem"
NGINX_ACME_KEY_PATH="/var/lib/marzneshin/certs/privkey.pem"
NGINX_WEBROOT_DIR="/var/lib/marzneshin/acme-webroot"

## Authentication & Subscriptions
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=1440
# SUBSCRIPTION_URL_PREFIX="https://example.com"
# VITE_BASE_API="./api/"
