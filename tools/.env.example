# Workstation configuration for tools/cluster_watch.py (copy to tools/.env and restrict permissions):
#   cp tools/.env.example tools/.env && chmod 600 tools/.env
#
# Use SSH aliases from ~/.ssh/config only — never store raw IPs, domains, UUIDs, or credentials here.

# Whitespace- or comma-separated <ssh_alias>:<role> pairs (roles: bridge, exit)
MARZNESHIN_WATCH_NODES="bridge-1:bridge exit-1:exit exit-2:exit"

# Whitespace- or comma-separated protected user aliases (merged with built-in "owner")
MARZNESHIN_PROTECT_USERS="owner"

# Optional Phase 2 alert command executed on CRITICAL findings
# MARZNESHIN_ALERT_CMD="/path/to/alert-hook"
